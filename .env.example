# OpenClaw Gateway API Token (Keep this secret!)
OPENCLAW_AUTH_TOKEN=your_token_here

# Pi's OpenClaw Gateway IP (e.g., http://192.168.1.100:8080)
OPENCLAW_API_URL=http://localhost:8000

# Fallback OpenClaw Gateway Base URL
OPENCLAW_GATEWAY_URL=http://localhost:8000

# Mission Control Base URL (for internal API calls)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
